{
  "name": "@asmr-collections/server",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "lint": "eslint .",
    "start": "pnpm run migration:deploy && bun --env-file=../../.env src/index.ts",
    "workers:dev": "wrangler dev",
    "workers:deploy": "wrangler deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "generate": "prisma generate",
    "migration:dev": "prisma migrate dev",
    "migration:deploy": "prisma migrate deploy",
    "status": "prisma migrate status",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm run generate"
  },
  "dependencies": {
    "@asmr-collections/shared": "workspace:*",
    "@asmr-collections/webdav": "workspace:*",
    "@epic-web/cachified": "^5.6.2",
    "@henrygd/queue": "^1.2.0",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cachified-adapter-sqlite": "^1.1.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "lru-cache": "^11.5.1",
    "music-metadata": "^11.12.3",
    "prisma": "^7.8.0",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "wrangler": "^4.97.0"
  },
  "imports": {
    "#_db": {
      "workerd": "./src/lib/_db.worker.ts",
      "default": "./src/lib/_db.ts"
    }
  }
}
